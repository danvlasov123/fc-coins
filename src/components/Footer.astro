---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand" href="/" aria-label="NINETY — home">
          <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="14" stroke="#C6FF3D" stroke-width="1.6"></circle>
            <circle cx="16" cy="16" r="5.2" stroke="#C6FF3D" stroke-width="1.1" opacity=".5"></circle>
            <path d="M16 2v28" stroke="#C6FF3D" stroke-width="1.1" opacity=".28"></path>
            <circle cx="16" cy="16" r="1.7" fill="#C6FF3D"></circle>
          </svg>
          <span>Ninety<span class="brand__dot">.</span></span>
        </a>
        <p>
          A curated catalogue of EA SPORTS FC coin packs. Compare the price, pick a
          platform, and finish the order with our verified partner.
        </p>
      </div>

      <div class="footer__col">
        <h4>Coins</h4>
        <a href="/fc-27-coins">FC 27 coins</a>
        <a href="/fc-27-coins/ps5">PS5 coins</a>
        <a href="/fc-27-coins/pc">PC coins</a>
        <a href="/fc-26-coins">FC 26 coins</a>
        <a href="/pricing">Price list</a>
      </div>

      <div class="footer__col">
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/compare">Compare stores</a>
        <a href="/blog">Guides</a>
        <a href="mailto:hello@ninetycoins.com">Contact</a>
      </div>

      <div class="footer__col">
        <h4>Legal</h4>
        <a href="/legal#terms">Terms of use</a>
        <a href="/legal#privacy">Privacy policy</a>
        <a href="/legal#disclaimer">Disclaimer</a>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} Ninety. All rights reserved.</span>
      <span>
        Not affiliated with Electronic Arts. EA SPORTS FC is a trademark of EA.
      </span>
    </div>
  </div>
</footer>
